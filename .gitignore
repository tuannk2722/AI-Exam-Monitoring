.DS_Store

# Data and media (DVC owns large binary content)
/data/raw/**
/data/interim/**
/data/processed/**
!/data/**/
!/data/**/.gitkeep
!/data/**/.gitignore
!/data/**/*.dvc
!*.dvc
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.npy

# ML artifacts
*.pt
*.pth
*.onnx
*.engine
/runs/
/outputs/*
!/outputs/*.dvc
# Exact metadata required by the measured B0 execution profile; no model/media.
!/outputs/verify-b0-01/
/outputs/verify-b0-01/**
!/outputs/verify-b0-01/parity/
!/outputs/verify-b0-01/parity/parity.json
!/outputs/verify-b0-01/B1/
!/outputs/verify-b0-01/B1/profile.json
!/outputs/verify-b0-01/B1/code.json
/artifacts/models/
/artifacts/predictions/
/artifacts/evidence/
/artifacts/wandb/
wandb/

# DVC local state/cache
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local

# Lịch sử local: Git chỉ giữ index và DVC pointer
/archive/*.zip
/archive/*.partial
/archive/work-plan.json
/archive/check/
/archive/restore/
